# --- LLM providers -------------------------------------------------------
# OpenAI powers embeddings + the agent. Leave empty to run in offline "dev mode"
# (hash embeddings + extractive answers) so the whole app still works locally.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Optional fallback: used automatically if the OpenAI call fails.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Infra ---------------------------------------------------------------
DATABASE_URL=postgres://docpilot:docpilot@localhost:5432/docpilot
REDIS_URL=redis://localhost:6379
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Web -----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
